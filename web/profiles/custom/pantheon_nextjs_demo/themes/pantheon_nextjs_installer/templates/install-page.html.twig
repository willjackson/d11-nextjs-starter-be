{#
/**
 * @file
 * Installer page for the Pantheon Next.js Multiple Site Demo.
 *
 * Adds the Pantheon logo above the standard Claro installer layout.
 */
#}
<div class="layout-container">

  <header class="pantheon-installer-header">
    <img class="pantheon-installer-logo" src="{{ base_path }}{{ directory }}/logo.svg" alt="Pantheon" />
    {% if site_name %}
      <h1 class="site-name">
        {{ site_name }}
        {% if site_version %}
          <span class="site-version">{{ site_version }}</span>
        {% endif %}
      </h1>
    {% endif %}
  </header>

  {% if page.sidebar_first %}
    <aside class="layout-sidebar-first">
      {{ page.sidebar_first }}
    </aside>{# /.layout-sidebar-first #}
  {% endif %}

  <main class="main-content">
    {% if title %}
      <h2 class="heading-c">{{ title }}</h2>
    {% endif %}
    {{ page.highlighted }}
    {{ page.content }}
  </main>

  {% if page.sidebar_second %}
    <aside class="layout-sidebar-second" >
      {{ page.sidebar_second }}
    </aside>{# /.layout-sidebar-second #}
  {% endif %}

  {% if page.page_bottom %}
    <footer>
      {{ page.page_bottom }}
    </footer>
  {% endif %}

</div>{# /.layout-container #}
